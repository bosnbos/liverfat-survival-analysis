# Data (never share)
*.RData

# R session files
.Rhistory
.RData
.Ruserdata

# RStudio files
.Rproj.user/

# Mac system files
.DS_Store

# Output files (rendered reports kept in reports/, but ignore stray PDFs/HTML elsewhere)
*.pdf
*.html
!reports/paper.pdf
!reports/slides.pdf
output/

# Temporary files
*.log
*.tmp

# LaTeX/knitr build artefacts (generated when knitting Rmd to PDF)
*.knit.md
*.tex
*_files/

# Word temp files
~$*

# Output plots (generated by R scripts, reproducible)
reports/*.png
